# Optional: load site content from a URL at runtime (edit content without redeploying).
# Leave unset to use the bundled src/data/portfolio.json.
# Example (GitHub Gist "raw" URL WITHOUT the commit hash, so it always serves the latest version):
# VITE_CONTENT_URL=https://gist.githubusercontent.com/<your-github-user>/<gist-id>/raw/portfolio.json
VITE_CONTENT_URL=
